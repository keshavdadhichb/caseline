# Core agent: query planning and SAR drafting. Required.
ANTHROPIC_API_KEY=sk-ant-...

# Optional presentation layer only: the "Explain simply" panel, its
# illustration, and speech in/out. Caseline runs fully without this; every
# feature that uses it degrades to a deterministic fallback (a plain-language
# summary built from the case's own figures, and the browser's built-in
# speech synthesiser). It never plans a query, never drafts a SAR, and never
# influences a risk score.
GEMINI_API_KEY=
# Optional model overrides, so a rename needs no code change.
# GEMINI_TEXT_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore
